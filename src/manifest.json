{
  "manifest_version": 3,
  "name": "Flygo Browser Bridge",
  "version": "0.1.0",
  "description": "Let your own Flygo AI agents drive this browser (Playwright MCP style), through Flygo Chat on this machine or your Flygo server.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms", "identity", "declarativeNetRequest", "webRequest", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Flygo Browser Bridge" },
  "sandbox": { "pages": ["sandbox.html"] },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
